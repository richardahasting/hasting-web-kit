# hasting-web-kit feedback service. Copy to .env and fill in.
APPS_CONFIG=/path/to/hasting-web-kit/service/apps.json
UPLOAD_DIR=/var/www/feedback-uploads
UPLOAD_URL_BASE=https://feedback.example.com/uploads
GITHUB_TOKEN=ghp_your_token_here
# CLAUDE_BIN=/path/to/claude   (default: `claude` found on PATH)
# FEEDBACK_EMAIL=you@example.com   (fallback if an app has no email_to)
# EMAIL_FROM=feedback@example.com  (fallback if an app has no email_from)
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW=3600
# SMTP_HOST=localhost
# SMTP_PORT=25
